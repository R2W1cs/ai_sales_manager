# Copy to .env.production and fill before `docker compose -f docker-compose.prod.yml up`.
NODE_ENV=production

# Public hostnames (DNS A/AAAA → your VPS)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com
BETTER_AUTH_URL=https://api.example.com
WEBHOOK_PUBLIC_URL=https://api.example.com/api/v1/webhooks/meta

# Secrets (generate strong values — never commit the real file)
POSTGRES_DB=ai_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long!!
ENCRYPTION_KEY=
TRUST_PROXY=true
COOKIE_SECURE=true

# Object storage (MinIO on the same compose network)
AWS_REGION=eu-west-3
S3_BUCKET=ai-sales-assets
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-password

# LLM (set at least one)
# GROQ_API_KEY=
# ORCA_API_KEY=
# AI_GATEWAY_API_KEY=

# Meta (Instagram / Messenger / WhatsApp Cloud API)
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# META_WEBHOOK_SECRET=
# META_OAUTH_REDIRECT_URI=https://app.example.com/integrations/callback
# META_WA_PHONE_NUMBER_ID=
# Enable only after Meta WhatsApp Business is verified for a pilot
WHATSAPP_ENABLED=false

EMAIL_FROM=AI Sales Manager <noreply@example.com>
# RESEND_API_KEY=
