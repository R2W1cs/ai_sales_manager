{
  "name": "@app/api",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/main.ts --outfile server",
    "dev": "pnpm db:start && tsdown --watch --no-clean --on-success \"node --enable-source-maps dist/main.mjs\"",
    "dev:app": "tsdown --watch --no-clean --on-success \"node --enable-source-maps dist/main.mjs\"",
    "dev:worker": "pnpm db:start && tsdown --watch --no-clean --on-success \"node --enable-source-maps dist/worker.mjs\"",
    "dev:worker:app": "tsdown --watch --no-clean --on-success \"node --enable-source-maps dist/worker.mjs\"",
    "start": "node dist/main.mjs",
    "start:worker": "node dist/worker.mjs",
    "test": "jest",
    "eval:golden": "jest --testPathPattern=\"test/golden-eval\" --verbose",
    "eval:bench": "tsx test/golden-eval/cli.ts",
    "eval:bench:live": "tsx test/golden-eval/cli.ts --live",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:start": "docker compose -f ../../docker-compose.yml up -d redis minio",
    "db:start:all": "docker compose -f ../../docker-compose.yml up -d postgres redis minio",
    "db:watch": "docker compose -f ../../docker-compose.yml up redis minio",
    "db:stop": "docker compose -f ../../docker-compose.yml stop redis minio",
    "db:stop:all": "docker compose -f ../../docker-compose.yml stop postgres redis minio",
    "db:down": "docker compose -f ../../docker-compose.yml down"
  },
  "dependencies": {
    "@ai-sdk/gateway": "catalog:",
    "@ai-sdk/openai": "^4.0.96",
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@better-auth/prisma-adapter": "^1.7.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "catalog:",
    "ai": "catalog:",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.1",
    "bullmq": "^5.81.2",
    "dotenv": "catalog:",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.22.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@nestjs/testing": "^11.2.1",
    "@playwright/test": "catalog:",
    "@types/jest": "^29.5.14",
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "playwright": "catalog:",
    "prisma": "^7.9.1",
    "ts-jest": "^29.2.5",
    "tsdown": "^0.22.3",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
