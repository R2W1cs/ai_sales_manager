# Application
NODE_ENV=development
# PORT is defined per application in apps/api/.env (4000) and apps/web/.env (3000)
# LOG_LEVEL=info
# PINO_PRETTY=true

# Database & Cache (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_sales
REDIS_URL=redis://localhost:6379
# Optional dedicated pgvector URL (falls back to DATABASE_URL)
# PGVECTOR_DATABASE_URL=
# Optional Redis host/port fallbacks if REDIS_URL is unset in tests
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication & Security (Better Auth required, min 32 characters)
BETTER_AUTH_SECRET=local-better-auth-secret-min-32-chars-long!
BETTER_AUTH_URL=http://localhost:4000
# RESEND_API_KEY=re_1234567890
EMAIL_FROM=AI Sales <noreply@ai-sales.app>
# Optional explicit cookie Secure override: true | false
# COOKIE_SECURE=
# Trust X-Forwarded-* headers. Defaults to true in production (behind the ALB)
# and false elsewhere. Only enable when a proxy overwrites these headers —
# otherwise X-Forwarded-For is forgeable and auth rate limiting can be bypassed.
# TRUST_PROXY=
# Optional token-encryption key (falls back to BETTER_AUTH_SECRET)
# ENCRYPTION_KEY=

# Vercel AI Gateway (single credential for OpenAI, Google Gemini, Anthropic Claude, etc.)
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Groq (OpenAI-compatible). Used first when GROQ_API_KEY is set.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# OrcaRouter (OpenAI-compatible). Used when Groq is unset.
# ORCA_API_KEY=
# ORCA_BASE_URL=https://api.orcarouter.ai/v1
# ORCA_MODEL=orcarouter/auto

# Meta WhatsApp / Instagram / Messenger (optional until channels are connected)
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# META_WEBHOOK_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/callback
# META_WA_PHONE_NUMBER_ID=
# WHATSAPP_ENABLED=false

# Storage (S3 / MinIO)
AWS_REGION=eu-west-3
S3_BUCKET=ai-sales-assets
# Local MinIO (omit keys in AWS production to use the task IAM role)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# URLs & CORS
CORS_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# WEBHOOK_PUBLIC_URL=http://localhost:4000/api/v1/webhooks/meta

# Frontend (Next.js) — public, inlined at build time
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
